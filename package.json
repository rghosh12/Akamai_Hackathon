{
  "name": "labstrata",
  "version": "1.0.0",
  "private": true,
  "description": "Version-locked lab protocols and evidence review with Akamai Cloud",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/*.test.js",
    "check": "node --check server.js && node --check public/app.js",
    "smoke:live": "node scripts/smoke-live.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1174.0"
  }
}
