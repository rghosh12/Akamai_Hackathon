# Templates only. Never commit .env, credentials, or signed URLs.
# Local development: copy to .env. Existing process environment takes precedence.
HOST=127.0.0.1
PORT=3000
# Defaults to this application's data/ directory.
DATA_DIR=

# Official Seattle workshop configuration (event key supplied separately).
AKAMAI_BASE_URL=https://api.akamai-inference.com/v1
AKAMAI_API_KEY=
CHAT_MODEL=qwen3-8-27b
# Optional override of CHAT_MODEL; retained for existing LabStrata configurations.
AKAMAI_MODEL=

# Private Chicago E3 bucket; bucket-scoped read/write credentials.
OBJ_ENDPOINT=https://us-ord-10.linodeobjects.com
OBJ_REGION=us-east-1
OBJ_BUCKET=
OBJ_ACCESS_KEY=
OBJ_SECRET_KEY=

# Production: inject secrets from a secret manager or systemd credentials.
# NODE_ENV=production disables reading .env.
# Secrets also support AKAMAI_API_KEY_FILE, OBJ_ACCESS_KEY_FILE, OBJ_SECRET_KEY_FILE.
