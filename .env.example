# Copy to .env (git-ignored). Never commit real values.

# --- Akamai Inference Cloud (OpenAI-compatible). Event key starts with sk_aka_ ---
AKAMAI_BASE_URL=https://api.akamai-inference.com/v1
AKAMAI_API_KEY=
AKAMAI_MODEL=qwen3-8-27b
AKAMAI_VISION_MODEL=gemma-4-26b-a4b-it
AKAMAI_EMBED_MODEL=qwen3-embedding-8b
PORT=3000

# --- Managed PostgreSQL (+pgvector), private VPC address only. Leave empty (or USE_JSON_DB=1) for data/db.json ---
DATABASE_URL=postgres://USER:PASSWORD@PRIVATE-DB-HOST:5432/defaultdb
DATABASE_CA_FILE=/etc/labstrata/db-ca.crt
USE_JSON_DB=0

# --- Akamai Object Storage (us-ord) ---
S3_ENDPOINT=https://us-ord-1.linodeobjects.com
S3_REGION=us-ord-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_CAPTURE_BUCKET=labstrata-capture
S3_LOCK_BUCKET=labstrata-records
# compliance (Object Lock) | versioning (fallback: versioning + SHA-256 manifest in Postgres)
S3_LOCK_MODE=compliance
S3_LOCK_DAYS=1

# --- Calibration / nodes ---
CAL_THRESHOLD=0.85
NODE_NAME=local
# 1 = node runs prompt v2 (subtly worse); it must fail its exam and never get traffic
CHECKER_FAULT=0
ADMIN_TOKEN=
PUBLIC_URL=

# --- Infra (only on the machine that runs infra/provision.mjs) ---
LINODE_TOKEN=
MY_IPS=
